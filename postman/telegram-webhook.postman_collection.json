{
  "info": {
    "name": "VEMO - Telegram Webhook",
    "description": "Simulates the updates Telegram POSTs to /telegram/webhook (TelegramWebhookController@handle). Set the collection variables base_url, webhook_secret, link_token and chat_id before running.\n\nNOTE: The link/relink requests mutate the database (they set telegram_chat_id on the user owning link_token). Run against a staging/local environment, not production data you care about.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://dev-vemo.tongtji.com",
      "type": "string"
    },
    {
      "key": "webhook_secret",
      "value": "e4e6e6794716260bb22c9c75b9c51186262488ed49f0bcd9",
      "type": "string"
    },
    {
      "key": "link_token",
      "value": "PASTE_A_VALID_telegram_link_token_FROM_THE_users_TABLE",
      "type": "string"
    },
    {
      "key": "chat_id",
      "value": "6710408181",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Link account (/start <token>) - valid secret",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('responds {ok:true}', function () {",
              "    pm.expect(pm.response.json()).to.have.property('ok', true);",
              "});",
              "// After this runs, verify in DB: the user with link_token now has",
              "// telegram_chat_id = {{chat_id}}, telegram_link_token = NULL, telegram_linked_at set."
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Telegram-Bot-Api-Secret-Token", "value": "{{webhook_secret}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"update_id\": 100000001,\n  \"message\": {\n    \"message_id\": 1,\n    \"from\": { \"id\": {{chat_id}}, \"is_bot\": false, \"first_name\": \"Gerson\" },\n    \"chat\": { \"id\": {{chat_id}}, \"first_name\": \"Gerson\", \"type\": \"private\" },\n    \"date\": 1781160141,\n    \"text\": \"/start {{link_token}}\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/telegram/webhook",
          "host": ["{{base_url}}"],
          "path": ["telegram", "webhook"]
        }
      }
    },
    {
      "name": "Reject - wrong secret",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Telegram-Bot-Api-Secret-Token", "value": "wrong-secret" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"update_id\": 100000002,\n  \"message\": {\n    \"message_id\": 2,\n    \"chat\": { \"id\": {{chat_id}}, \"type\": \"private\" },\n    \"text\": \"/start {{link_token}}\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/telegram/webhook",
          "host": ["{{base_url}}"],
          "path": ["telegram", "webhook"]
        }
      }
    },
    {
      "name": "Reject - missing secret header",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('403 Forbidden', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"update_id\": 100000003,\n  \"message\": {\n    \"message_id\": 3,\n    \"chat\": { \"id\": {{chat_id}}, \"type\": \"private\" },\n    \"text\": \"/start {{link_token}}\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/telegram/webhook",
          "host": ["{{base_url}}"],
          "path": ["telegram", "webhook"]
        }
      }
    },
    {
      "name": "Bare /start (no token) - valid secret",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('responds {ok:true}', function () {",
              "    pm.expect(pm.response.json()).to.have.property('ok', true);",
              "});",
              "// Does NOT link; the bot replies with the 'open VEMO -> Connect Telegram' hint."
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Telegram-Bot-Api-Secret-Token", "value": "{{webhook_secret}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"update_id\": 100000004,\n  \"message\": {\n    \"message_id\": 4,\n    \"chat\": { \"id\": {{chat_id}}, \"type\": \"private\" },\n    \"text\": \"/start\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/telegram/webhook",
          "host": ["{{base_url}}"],
          "path": ["telegram", "webhook"]
        }
      }
    },
    {
      "name": "Non-start message - valid secret (ignored)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('responds {ok:true}', function () {",
              "    pm.expect(pm.response.json()).to.have.property('ok', true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Telegram-Bot-Api-Secret-Token", "value": "{{webhook_secret}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"update_id\": 100000005,\n  \"message\": {\n    \"message_id\": 5,\n    \"chat\": { \"id\": {{chat_id}}, \"type\": \"private\" },\n    \"text\": \"halo\"\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/telegram/webhook",
          "host": ["{{base_url}}"],
          "path": ["telegram", "webhook"]
        }
      }
    }
  ]
}
